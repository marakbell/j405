mean = mean(Happiness, na.rm = TRUE),
median = median(Happiness, na.rm = TRUE),
min = min(Happiness, na.rm = TRUE),
max = max(Happiness, na.rm = TRUE))
glimpse(billboard)
billboard |>
summarize(
rows <- n(),
columns <- ncol(billboard)
)
glimpse(billboard)
billboard |>
summarize(
rows <- n(),
columns <- ncol(.)
)
glimpse(billboard)
billboard |>
summarize(
rows <- n(billboard),
columns <- ncol(billboard)
)
glimpse(billboard)
billboard |>
summarize(
rows <- n(),
columns <- ncol(billboard)
)
