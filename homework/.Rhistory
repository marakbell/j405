library(tidyverse)
library(janitor)
md_cities <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_cities_crime_2019_2020.csv") |>
clean_names()
md_cities_rates <- md_cities |>
mutate(violent_rate_2019 = violent2019/pop2019 * 1000, property_rate_2019= property2019/pop2019 * 1000, violent_rate_2020 = violent2020/pop2020 * 1000, property_rate_2020= property2020/pop2020 * 1000)
md_cities_change <- md_cities_rates |>
mutate(violent_change =  (violent_rate_2020 - violent_rate_2019)/violent_rate_2019 * 100) |>
mutate(property_change =  (property_rate_2020 - property_rate_2019)/property_rate_2019 * 100)
View(md_cities_rates)
View(md_cities_change)
md_cities_percentiles <- md_cities_rates |>
mutate(percentile = ntile(violent_rate_2020, 100))
View(md_cities)
View(md_cities_rates)
View(md_cities_change)
View(md_cities_percentiles)
md_cities_percentiles <- md_cities_rates |>
mutate(percentile = ntile(violent_rate_2020, 100))
md_cities_percentiles |>
select (1,2,11,13)
View(md_cities_percentiles)
md_cities_percentiles |> summarize(IQR = IQR(count))
violent_rate_2020 |> summarize(IQR = IQR(count))
violent_rate_2020 |> summarize(IQR = IQR(violent_rate_2020))
md_cities_percentiles |> summarize(IQR = IQR(violent_rate_2020))
